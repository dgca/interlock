{
  "name": "@type_of/interlock",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,ui \"pnpm --filter @interlock/server dev\" \"pnpm --filter @interlock/ui dev\"",
    "build": "pnpm typecheck && pnpm --filter @interlock/ui build && node scripts/build-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "start": "pnpm --filter @interlock/server start",
    "cli": "pnpm --filter @interlock/cli start",
    "mcp": "pnpm --filter @interlock/mcp start",
    "changeset": "changeset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepack": "pnpm build",
    "test:package": "node scripts/test-package.mjs",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm test && pnpm build && pnpm test:package && changeset publish"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@hono/node-server": "^1.19.17",
    "@interlock/client": "workspace:*",
    "@interlock/core": "workspace:*",
    "@interlock/runtime": "workspace:*",
    "@interlock/storage": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "version": "0.1.7",
  "license": "MIT",
  "description": "Local workflow engine and visual editor for agent harnesses",
  "bin": {
    "interlock": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTEXT.md",
    "docs"
  ],
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dgca/interlock.git"
  }
}
