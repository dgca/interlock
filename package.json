{
  "name": "@type_of/interlock",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=24.13.0"
  },
  "scripts": {
    "dev": "concurrently -k -n server,ui \"pnpm --filter @interlock/server dev\" \"tsx scripts/wait-for-engine.ts && pnpm --filter @interlock/ui dev\"",
    "build": "pnpm typecheck && pnpm --filter @interlock/ui build && node scripts/build-package.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "start": "pnpm --filter @interlock/server start",
    "cli": "pnpm --filter @interlock/cli start",
    "mcp": "pnpm --filter @interlock/mcp start",
    "docs:dev": "pnpm --filter @interlock/docs start",
    "site:build": "node scripts/build-site.mjs",
    "site:check": "node scripts/check-site.mjs",
    "site:preview": "node scripts/preview-site.mjs",
    "changeset": "changeset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint:deps": "depcruise packages --config .dependency-cruiser.mjs --ignore-known .dependency-cruiser-known-violations.json",
    "lint:unused": "node scripts/check-unused.mjs",
    "prepack": "pnpm build",
    "test:package": "node scripts/test-package.mjs",
    "test:kill": "node scripts/test-kill-recovery.mjs",
    "release:status": "changeset status",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release": "pnpm test && pnpm build && pnpm test:package && changeset publish",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.316",
    "@changesets/cli": "^2.29.7",
    "@eslint/css": "^2.0.1",
    "@eslint/js": "^10.0.1",
    "@hono/node-server": "^1.19.17",
    "@interlock/client": "workspace:*",
    "@interlock/core": "workspace:*",
    "@interlock/runtime": "workspace:*",
    "@interlock/storage": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@trpc/client": "11.18.0",
    "@trpc/server": "11.18.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "concurrently": "^9.2.1",
    "dependency-cruiser": "^18.7.2",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "jsdom": "^30.0.1",
    "knip": "^6.45.1",
    "playwright": "^1.65.0",
    "prettier": "^3.6.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^3.2.4",
    "zod": "^4.6.7"
  },
  "version": "0.2.17",
  "license": "MIT",
  "description": "Local workflow engine and visual editor for agent harnesses",
  "bin": {
    "interlock": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "CONTEXT.md",
    "docs",
    "skill",
    "workflows"
  ],
  "publishConfig": {
    "access": "public"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/dgca/interlock.git"
  }
}
