{
  "interlock-pr-watcher": {
    "name": "Pull request watcher routes",
    "cases": [
      {
        "id": "fix-failing-check",
        "name": "An SDLC run's event starts the watcher; a failing check is fixed, reviewed and pushed with no person involved",
        "input": {
          "eventId": "e1",
          "type": "completed",
          "occurredAt": "2026-11-13T10:00:00.000Z",
          "runId": "run-1",
          "workflowId": "sdlc",
          "version": 1,
          "stage": "Delivery",
          "waiting": null,
          "repoPath": "/tmp"
        },
        "fixtures": [
          {
            "nodeId": "setup",
            "kind": "script",
            "output": {
              "route": "watch",
              "repoPath": "/tmp",
              "url": "https://github.com/o/r/pull/7",
              "maxRepairs": 2,
              "checkCommands": null,
              "since": "2026-11-13T10:00:00.000Z",
              "summary": "Watching"
            }
          },
          {
            "nodeId": "watch",
            "kind": "script",
            "output": {
              "settled": true,
              "status": "failing",
              "head": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "checkedAt": "2026-11-13T10:30:00.000Z",
              "failed": [],
              "blocked": [],
              "pendingChecks": 0,
              "comments": [],
              "ignoredComments": 0
            }
          },
          {
            "nodeId": "triage",
            "kind": "script",
            "output": { "route": "fix", "kind": null, "summary": "fix" }
          },
          {
            "nodeId": "prepare",
            "kind": "script",
            "output": {
              "prHead": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "criteria": "CHECK1: the check passes",
              "since": "2026-11-13T10:30:00.000Z"
            }
          },
          {
            "nodeId": "fix",
            "kind": "workflow",
            "output": {
              "status": "done",
              "summary": "fixed",
              "headCommit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "resolutions": [
                { "id": "CHECK1", "status": "fixed", "details": "d" }
              ]
            }
          },
          {
            "nodeId": "changeReview",
            "kind": "workflow",
            "output": {
              "verdict": "pass",
              "summary": "review",
              "reviewedCommit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "reviewScope": "full",
              "criteria": [
                { "id": "CHECK1", "status": "verified", "evidence": "e" }
              ],
              "findings": [],
              "resolutions": [],
              "limitations": [],
              "baseCommit": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "headCommit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "checksPassed": null,
              "checks": []
            }
          },
          {
            "nodeId": "reviewRoute",
            "kind": "script",
            "output": { "route": "push", "review": null, "summary": "s" }
          },
          {
            "nodeId": "push",
            "kind": "script",
            "output": {
              "route": "watch",
              "pushed": true,
              "commit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "since": "2026-11-13T10:30:00.000Z",
              "summary": "Pushed"
            }
          },
          {
            "nodeId": "watch",
            "kind": "script",
            "output": {
              "settled": true,
              "status": "merged",
              "head": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "checkedAt": "2026-11-13T10:30:00.000Z",
              "failed": [],
              "blocked": [],
              "pendingChecks": 0,
              "comments": [],
              "ignoredComments": 0
            }
          },
          {
            "nodeId": "triage",
            "kind": "script",
            "output": {
              "route": "done",
              "kind": null,
              "summary": "done",
              "outcome": "merged"
            }
          },
          {
            "nodeId": "finish",
            "kind": "script",
            "output": {
              "outcome": "merged",
              "prUrl": "https://github.com/o/r/pull/7",
              "repairs": 1,
              "lastPushedCommit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "summary": "merged"
            }
          }
        ],
        "assertions": [
          {
            "kind": "output",
            "path": "outcome",
            "operator": "equals",
            "expected": "merged"
          },
          { "kind": "route", "nodeId": "push", "visit": 1, "port": "watch" },
          { "kind": "route", "nodeId": "watch", "visit": 2, "port": "default" }
        ]
      },
