          {
            "nodeId": "reviewRoute",
            "kind": "script",
            "output": { "route": "push", "review": null, "summary": "s" }
          },
          {
            "nodeId": "push",
            "kind": "script",
            "output": {
              "route": "watch",
              "pushed": true,
              "commit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "since": "2026-11-13T10:30:00.000Z",
              "summary": "Pushed"
            }
          },
          {
            "nodeId": "watch",
            "kind": "script",
            "output": {
              "settled": true,
              "status": "failing",
              "head": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "checkedAt": "2026-11-13T10:30:00.000Z",
              "failed": [],
              "blocked": [],
              "pendingChecks": 0,
              "comments": [],
              "ignoredComments": 0
            }
          },
          {
            "nodeId": "triage",
            "kind": "script",
            "output": {
              "route": "attention",
              "kind": "limit",
              "summary": "attention"
            }
          },
          {
            "nodeId": "attentionAsk",
            "kind": "script",
            "output": {
              "kind": "limit",
              "question": "Keep watching?",
              "context": "c",
              "evidence": "e",
              "revision": "limit"
            }
          },
          {
            "nodeId": "attention",
            "kind": "input",
            "output": { "choice": "stop" }
          },
          {
            "nodeId": "grant",
            "kind": "script",
            "output": {
              "route": "stop",
              "outcome": "stopped",
              "repairUntil": 2,
              "summary": "stop"
            }
          },
          {
            "nodeId": "finish",
            "kind": "script",
            "output": {
              "outcome": "stopped",
              "prUrl": "https://github.com/o/r/pull/7",
              "repairs": 1,
              "lastPushedCommit": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
              "summary": "stopped"
            }
          }
        ],
        "assertions": [
          {
            "kind": "output",
            "path": "outcome",
            "operator": "equals",
            "expected": "stopped"
          },
          {
            "kind": "route",
            "nodeId": "triage",
            "visit": 2,
            "port": "attention"
          },
          {
            "kind": "route",
            "nodeId": "attention",
            "visit": 1,
            "port": "default"
          }
        ]
      },
      {
        "id": "error-then-stop",
        "name": "A setup error asks a person",
        "input": {
          "prUrl": "https://github.com/o/r/pull/7",
          "repoPath": "/tmp",
          "maxRepairs": 1
        },
        "fixtures": [
          { "nodeId": "setup", "kind": "script", "error": "gh: not logged in" },
          {
            "nodeId": "attentionAsk",
            "kind": "script",
            "output": {
              "kind": "error",
              "question": "Keep watching?",
              "context": "c",
              "evidence": "e",
              "revision": "error"
            }
          },
          {
            "nodeId": "attention",
            "kind": "input",
            "output": { "choice": "stop" }
          },
          {
            "nodeId": "grant",
            "kind": "script",
            "output": {
              "route": "stop",
              "outcome": "stopped",
              "repairUntil": 2,
              "summary": "stop"
            }
          },
          {
            "nodeId": "finish",
            "kind": "script",
            "output": {
              "outcome": "stopped",
              "prUrl": "https://github.com/o/r/pull/7",
              "repairs": 0,
              "lastPushedCommit": null,
              "summary": "stopped"
            }
          }
        ],
        "assertions": [
          {
            "kind": "output",
            "path": "outcome",
            "operator": "equals",
            "expected": "stopped"
          },
          { "kind": "route", "nodeId": "setup", "visit": 1, "port": "failed" }
        ]
      },
