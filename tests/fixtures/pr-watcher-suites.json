              "resolutions": [
                { "id": "CHECK1", "status": "fixed", "details": "d" }
              ]
            }
          },
          {
            "nodeId": "changeReview",
            "kind": "workflow",
            "output": {
              "verdict": "pass",
              "summary": "review",
