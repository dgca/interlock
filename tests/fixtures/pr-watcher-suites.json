  "interlock-pr-watcher (one-interval window)": {
    "name": "Pull request watcher window",
    "cases": [
      {
        "id": "window-green",
        "name": "A window that ends with every check green and no trusted comment ends the run quietly",
        "input": {
          "prUrl": "https://github.com/o/r/pull/7",
          "repoPath": "/tmp",
          "maxRepairs": 1
        },
        "fixtures": [
          {
            "nodeId": "setup",
            "kind": "script",
            "output": {
              "route": "watch",
              "repoPath": "/tmp",
              "url": "https://github.com/o/r/pull/7",
              "maxRepairs": 2,
              "checkCommands": null,
              "since": "2026-11-13T10:00:00.000Z",
              "summary": "Watching"
            }
          },
          {
            "nodeId": "watch",
            "kind": "script",
            "output": {
              "settled": false,
              "status": "passing",
              "head": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "checkedAt": "2026-11-13T10:30:00.000Z",
              "failed": [],
              "blocked": [],
              "pendingChecks": 0,
              "comments": [],
              "ignoredComments": 0
            }
          },
          {
            "nodeId": "windowCheck",
            "kind": "script",
            "output": {
              "settled": false,
              "status": "passing",
              "head": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb",
              "checkedAt": "2026-11-13T10:30:00.000Z",
              "failed": [],
              "blocked": [],
              "pendingChecks": 0,
              "comments": [],
              "ignoredComments": 0
            }
          },
          {
            "nodeId": "finish",
            "kind": "script",
            "output": {
              "outcome": "checks_passed",
              "prUrl": "https://github.com/o/r/pull/7",
              "repairs": 0,
              "lastPushedCommit": null,
              "summary": "checks_passed"
            }
          }
        ],
        "assertions": [
          {
            "kind": "output",
            "path": "outcome",
            "operator": "equals",
            "expected": "checks_passed"
          },
          { "kind": "route", "nodeId": "watch", "visit": 1, "port": "timeout" },
          {
            "kind": "route",
            "nodeId": "windowCheck",
            "visit": 1,
            "port": "passing"
          }
        ]
      },
