              "items": {
                "type": "object",
                "properties": {
                  "sampleId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 120
                  },
                  "reason": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": ["sampleId", "reason"],
                "additionalProperties": false
              },
              "maxItems": 100
            },
            "remaining": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "comparisonId",
            "rubric",
            "mode",
            "outputPath",
            "maxSamples",
            "evaluationRunId",
            "samples",
            "skipped",
            "remaining"
          ],
          "additionalProperties": false
        },
        "command": "// Ask this Interlock for the evaluation plan. The server selects the samples\n// and builds each grader input, so this step decides nothing about grading.\nconst url = process.env.INTERLOCK_URL;\nif (!url) throw new Error('INTERLOCK_URL is not set; run this workflow on an Interlock server');\nconst headers = {};\n// Set only when the server requires it; never logged or returned.\nconst token = process.env.INTERLOCK_API_TOKEN;\nif (token) headers.authorization = `Bearer ${token}`;\nconst evaluationRunId = process.env.INTERLOCK_RUN_ID;\nconst response = await fetch(\n  `${url}/api/comparisons/${encodeURIComponent(input.comparisonId)}/evaluation-plan?evaluationRunId=${encodeURIComponent(evaluationRunId)}`,\n  { headers, signal: AbortSignal.timeout(20000) },\n);\nconst plan = await response.json().catch(() => ({}));\nif (!response.ok) throw new Error(`Interlock answered HTTP ${response.status}: ${plan.error ?? ''}`);\nfor (const key of ['comparisonId', 'rubric', 'mode', 'outputPath', 'maxSamples'])\n  if (plan[key] !== input[key]) throw new Error(`The evaluation plan's ${key} differs from the captured settings`);\n// Review order follows a hash of the run and sample IDs, not side or case order.\nconst { createHash } = require('node:crypto');\nconst order = (s) => createHash('sha256').update(evaluationRunId + ':' + s.sampleId).digest('hex');\nconst samples = [...plan.samples].sort((a, b) => order(a).localeCompare(order(b)));\nreturn { ...plan, samples };"
      },
