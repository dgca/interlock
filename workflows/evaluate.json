        "command": "const checks = input.checks;\nconst verdict = checks.some(c => c.status === 'fail') ? 'fail' : !checks.length || checks.some(c => c.status === 'unknown') ? 'unknown' : 'pass';\nreturn { evaluationRunId: input.evaluationRunId, sampleId: input.sampleId, rubric: input.rubric, mode: input.mode, outputPath: input.outputPath, verdict, score: verdict === 'pass' ? 5 : 0, notes: 'Frozen structural checks only; semantic quality was not reviewed.', evidence: input.evidence, findings: checks.slice(0,10).map(c => ({ criterion: 'check:' + c.index, status: c.status, notes: c.reason, references: ['check:' + c.index] })) };"
      },
      {
        "id": "record",
        "kind": "script",
        "label": "Record the accepted grade once",
        "position": {
          "x": 1340,
          "y": 420
        },
        "batchId": "evaluate",
        "language": "javascript",
        "inputBindings": {
          "sample": {
