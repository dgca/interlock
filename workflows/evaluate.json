        },
        "outputSchema": {
          "type": "object",
          "properties": {
            "sampleId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "judgmentId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "requestId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "verdict": {
              "type": "string",
              "enum": ["pass", "fail", "unknown"]
            },
            "score": {
              "type": "number",
              "minimum": 0,
              "maximum": 5
            },
            "comparisonSampleCount": {
              "type": "integer",
              "minimum": 1
            }
          },
          "required": [
