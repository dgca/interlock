            "judgmentId",
            "requestId",
            "verdict",
            "score",
            "comparisonSampleCount"
          ],
          "additionalProperties": false
        },
        "command": "// Record the grade the previous step produced. The server reads that step's\n// accepted output in this item run and checks its provenance, so this step\n// never copies or changes a score, notes or evidence.\nconst { comparisonId, evaluationRunId, sampleId } = input.sample;\nconst url = process.env.INTERLOCK_URL;\nif (!url) throw new Error('INTERLOCK_URL is not set; run this workflow on an Interlock server');\nconst headers = { 'content-type': 'application/json' };\nconst token = process.env.INTERLOCK_API_TOKEN;\nif (token) headers.authorization = `Bearer ${token}`;\nconst body = JSON.stringify({ evaluationRunId, reviewerRunId: process.env.INTERLOCK_RUN_ID, sampleId });\n// The request key is always evaluationRunId:sampleId. Repeating the same\n// request after a lost response returns the original judgment, never a second one.\nlet response;\nlet answer = {};\nfor (let attempt = 1; ; attempt++) {\n  try {\n    response = await fetch(`${url}/api/comparisons/${encodeURIComponent(comparisonId)}/judgments`, {\n      method: 'POST',\n      headers,\n      body,\n      signal: AbortSignal.timeout(15000),\n    });\n    answer = await response.json().catch(() => ({}));\n    if (response.status < 500 || attempt === 3) break;\n  } catch (error) {\n    if (attempt === 3) throw error;\n  }\n  await new Promise((resolve) => setTimeout(resolve, 100 * attempt));\n}\nif (!response.ok) throw new Error(`Interlock answered HTTP ${response.status}: ${answer.error ?? ''}`);\nreturn {\n  sampleId,\n  judgmentId: answer.id,\n  requestId: answer.requestId,\n  verdict: answer.evaluation.verdict,\n  score: answer.score,\n  comparisonSampleCount: answer.evaluation.comparisonSampleCount,\n};",
        "timeoutMs": 60000
      },
      {
        "id": "summarize",
        "kind": "script",
        "label": "Report coverage and usage scope",
        "position": {
          "x": 1620,
          "y": 100
        },
        "language": "javascript",
        "inputBindings": {
          "results": {
            "source": "input",
            "path": ""
          },
          "plan": {
            "source": "node",
            "nodeId": "plan",
            "path": ""
          }
        },
        "command": "const plan = input.plan;\nconst rows = input.results;\nconst recorded = rows.filter(r => r.status === 'completed').map(r => r.output);\nconst failures = rows.filter(r => r.status !== 'completed').map(r => ({ runId: r.runId, reason: String(r.error ?? r.status).slice(0,500) }));\nconst comparisonSampleCount = recorded[0]?.comparisonSampleCount ?? null;\nconst remaining = comparisonSampleCount === null ? plan.remaining : Math.max(plan.remaining, comparisonSampleCount - plan.samples.length - plan.skipped.length, 0);\nconst count = verdict => recorded.filter(r => r.verdict === verdict).length;\nreturn { comparisonId: plan.comparisonId, evaluationRunId: plan.evaluationRunId, mode: plan.mode, selected: plan.samples.length, recorded: recorded.length, failed: failures.length, passed: count('pass'), qualityFailed: count('fail'), unknown: count('unknown'), skipped: plan.skipped, remaining, comparisonSampleCount, state: recorded.length === comparisonSampleCount && recorded.length > 0 && !failures.length && !count('unknown') && recorded.length === plan.samples.length && !plan.skipped.length && !remaining ? 'complete' : 'partial', acceptance: 'not_decided', receipts: recorded, failures, usageRef: { runId: plan.evaluationRunId, includeDescendants: true } };"
      },
