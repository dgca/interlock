        "command": "const rubric = input.rubric.trim();\nif (!rubric) throw new Error('Provide a nonempty fixed rubric');\nreturn { comparisonId: input.comparisonId, rubric, mode: input.mode ?? 'review', outputPath: input.outputPath ?? '', maxSamples: input.maxSamples ?? 10 };"
