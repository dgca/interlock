        "command": "const { createHash } = require('node:crypto');\nconst key = s => createHash('sha256').update(input.evaluationRunId + ':' + s.sampleId).digest('hex');\nconst seen = new Set();\nconst samples = input.samples.map(s => {\n  if (seen.has(s.sampleId)) throw new Error('Duplicate selected sample');\n  seen.add(s.sampleId);\n  return { comparisonId: input.comparisonId, rubric: input.rubric, mode: input.mode, outputPath: input.outputPath, maxSamples: input.maxSamples, evaluationRunId: input.evaluationRunId, sampleId: s.sampleId, runId: s.runId, caseId: s.caseId, guidance: s.guidance, checks: s.checks, evidence: input.mode === 'checks_only' ? s.evidence : [] };\n}).sort((a,b) => key(a).localeCompare(key(b)));\nif (samples.length > input.maxSamples) throw new Error('Selection exceeds captured sample limit');\nreturn { ...input, samples };"
