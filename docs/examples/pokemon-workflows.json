    {
      "id": "a0337558-10f3-4f64-8d28-9aeda4e19f5b",
      "name": "Size up a Pokémon",
      "description": "Look a Pokémon up on PokéAPI, compute its stat sheet, then branch: small and adorable ones get an agent-written mascot pitch, the rest keep their raw stats.",
      "ownerWorkflowId": null,
      "draft": {
        "inputSchema": {
          "type": "object",
          "required": ["name"],
          "properties": {
            "name": {
              "type": "string"
            }
          }
        },
        "outputSchema": {},
        "nodes": [
          {
            "id": "entry",
            "label": "Pokémon name",
            "position": {
              "x": 40,
              "y": 200
            },
            "inputSchema": {},
            "outputSchema": {},
            "kind": "entry"
          },
          {
            "id": "lookup",
            "label": "Ask PokéAPI",
            "position": {
              "x": 300,
              "y": 200
            },
            "inputSchema": {},
            "outputSchema": {
              "type": "object",
              "required": ["status", "headers", "body"],
              "properties": {
                "status": {
                  "type": "integer"
                },
                "headers": {
                  "type": "object",
                  "additionalProperties": {
                    "type": "string"
                  }
                },
                "body": {}
              }
            },
            "kind": "fetch",
            "url": "https://pokeapi.co/api/v2/pokemon/{{input.name}}",
            "method": "GET",
            "query": [],
            "headers": [],
            "body": {
              "kind": "none"
            },
            "timeoutMs": 30000,
            "failOnHttpError": true
          },
          {
            "id": "stats",
            "label": "Pull the fun stats",
            "position": {
              "x": 580,
              "y": 200
            },
            "inputSchema": {},
            "outputSchema": {},
            "kind": "script",
            "language": "javascript",
            "command": "const body = input.body;\nif (!body || typeof body.name !== 'string')\n  throw new Error('PokéAPI did not recognize that name');\nconst stats = {};\nfor (const stat of body.stats ?? []) stats[stat.stat.name] = stat.base_stat;\nreturn {\n  name: body.name,\n  types: (body.types ?? []).map((entry) => entry.type.name),\n  heightM: (body.height ?? 0) / 10,\n  weightKg: (body.weight ?? 0) / 10,\n  smallAndAdorable: (body.height ?? 999) <= 6,\n  stats,\n};",
            "timeoutMs": 30000
          },
          {
            "id": "cute-check",
            "label": "Small and adorable?",
            "position": {
              "x": 860,
              "y": 200
            },
            "inputSchema": {},
            "outputSchema": {},
            "kind": "condition",
            "path": "smallAndAdorable",
            "equals": true
          },
          {
            "id": "mascot-pitch",
            "label": "Write the mascot pitch",
            "position": {
              "x": 1140,
              "y": 90
            },
            "inputSchema": {},
            "outputSchema": {
              "type": "object",
              "required": ["name", "pitch", "reasoning"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "pitch": {
                  "type": "string"
                },
                "reasoning": {
                  "type": "string"
                }
              }
            },
            "kind": "agent",
            "prompt": "Write a delightfully overcommitted mascot pitch for the Pokémon in the input, a scouting sheet with name, types, height, weight, and base stats. One short paragraph that leans into how small and adorable it is while citing one real stat as evidence. Do not invent abilities or moves. Return an object with name, pitch, and reasoning.",
            "context": {
              "mode": "current",
              "instructions": "Stay playful but keep every factual claim grounded in the input scouting sheet.",
              "tools": [],
              "skills": []
            },
            "maxAttempts": 2
          },
          {
            "id": "exit-pitch",
            "label": "Mascot pitch",
            "position": {
              "x": 1460,
              "y": 90
            },
            "inputSchema": {},
            "outputSchema": {},
            "kind": "exit"
          },
          {
            "id": "exit-stats",
            "label": "Stat sheet",
            "position": {
              "x": 1140,
              "y": 310
            },
            "inputSchema": {},
            "outputSchema": {},
            "kind": "exit"
          }
        ],
        "edges": [
